# Copie para .env e ajuste conforme o ambiente.

APP_NAME=Jabuti API
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1

# URL do Postgres
DATABASE_URL=postgresql+asyncpg://jabuti:jabuti@localhost:5432/jabuti

# Credenciais do Postgres
POSTGRES_USER=jabuti
POSTGRES_PASSWORD=jabuti
POSTGRES_DB=jabuti

